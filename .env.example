# Use catalogue-demo for the keyless AIC metadata preview, or artifact for the
# two persistent artifact services. Catalogue-demo supports keyword mode only.
MNEMOSYNE_SEARCH_MODE=catalogue-demo
# Required for each toggle option when MNEMOSYNE_SEARCH_MODE=artifact; these are
# server-only and never exposed to the browser.
MNEMOSYNE_KEYWORD_SEARCH_SERVICE_URL=http://127.0.0.1:8765/v1/search
MNEMOSYNE_EMBEDDING_SEARCH_SERVICE_URL=http://127.0.0.1:8766/v1/search
# Server-only Hugging Face read token used by the Next.js proxy when the
# embedding backend is a private Space. Never expose this as NEXT_PUBLIC_*.
MNEMOSYNE_EMBEDDING_SEARCH_SERVICE_TOKEN=
# Visual cold starts may exceed the metadata service's fixed 15-second timeout.
# Values are milliseconds and are capped by the application at 120000.
MNEMOSYNE_EMBEDDING_SEARCH_TIMEOUT_MS=60000
