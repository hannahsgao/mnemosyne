# Use catalogue-demo for the keyless AIC metadata preview, or artifact for the
# persistent Met-keyword/embedding service. The route never switches silently.
MNEMOSYNE_SEARCH_MODE=catalogue-demo
# Required when MNEMOSYNE_SEARCH_MODE=artifact; never exposed to the browser.
MNEMOSYNE_SEARCH_SERVICE_URL=http://127.0.0.1:8765/v1/search
